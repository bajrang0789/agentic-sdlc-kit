{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bajrang0789/agentic-sdlc-kit/main/schemas/v1/track-state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "states", "revisionInvalidation", "postReleaseRevisionRule"],
  "properties": {
    "apiVersion": { "const": "agentic-sdlc-kit/method/v1" },
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "terminal", "sideState", "transitions"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/trackState" },
          "terminal": { "type": "boolean" },
          "sideState": { "type": "boolean" },
          "transitions": {
            "type": "array",
            "maxItems": 32,
            "items": { "$ref": "common.schema.json#/$defs/trackState" },
            "uniqueItems": true
          },
          "resumeToRecordedPriorState": { "type": "boolean" },
          "resumeRequires": { "type": "string", "maxLength": 128 }
        }
      },
      "uniqueItems": true
    },
    "revisionInvalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromStates", "returnsTo", "rule"],
      "properties": {
        "fromStates": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/trackState" }
        },
        "returnsTo": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/trackState" }
        },
        "rule": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "postReleaseRevisionRule": { "type": "string", "minLength": 1, "maxLength": 2048 }
  }
}
