{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bajrang0789/agentic-sdlc-kit/main/schemas/v1/trail-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "id",
    "threadId",
    "sequence",
    "priorDigest",
    "digest",
    "kind",
    "recordedAt",
    "actor",
    "repository"
  ],
  "properties": {
    "apiVersion": { "const": "agentic-sdlc-kit/v1" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "threadId": { "$ref": "common.schema.json#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "priorDigest": { "$ref": "common.schema.json#/$defs/digest" },
    "digest": { "$ref": "common.schema.json#/$defs/digest" },
    "kind": { "enum": ["lifecycle", "claim", "source", "control-decision", "handoff", "learning"] },
    "recordedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "type": { "enum": ["human", "agent", "system"] }
      }
    },
    "repository": { "$ref": "common.schema.json#/$defs/repository" },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "common.schema.json#/$defs/trackState" },
        "to": { "$ref": "common.schema.json#/$defs/trackState" }
      }
    },
    "payloadReference": { "$ref": "common.schema.json#/$defs/sourceReference" },
    "revisionInvalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromRevision", "toRevision", "staleRecordIds"],
      "properties": {
        "fromRevision": { "$ref": "common.schema.json#/$defs/revision" },
        "toRevision": { "$ref": "common.schema.json#/$defs/revision" },
        "staleRecordIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": { "$ref": "common.schema.json#/$defs/id" },
          "uniqueItems": true
        }
      }
    },
    "supersedesId": { "$ref": "common.schema.json#/$defs/id" }
  }
}
