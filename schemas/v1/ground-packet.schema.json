{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bajrang0789/agentic-sdlc-kit/main/schemas/v1/ground-packet.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "threadId",
    "repository",
    "intendedOutcome",
    "acceptanceCriteria",
    "actionBand",
    "trackState",
    "controlPoints",
    "knownUnknowns",
    "expiresAt"
  ],
  "properties": {
    "apiVersion": { "const": "agentic-sdlc-kit/v1" },
    "threadId": { "$ref": "common.schema.json#/$defs/id" },
    "repository": { "$ref": "common.schema.json#/$defs/repository" },
    "intendedOutcome": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
    },
    "constraints": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "maxLength": 2048 }
    },
    "repositoryMap": { "$ref": "common.schema.json#/$defs/sourceReference" },
    "reachMap": { "$ref": "common.schema.json#/$defs/sourceReference" },
    "actionBand": { "$ref": "common.schema.json#/$defs/actionBand" },
    "trackState": { "$ref": "common.schema.json#/$defs/trackState" },
    "controlPoints": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "common.schema.json#/$defs/id" },
      "uniqueItems": true
    },
    "knownUnknowns": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "maxLength": 2048 }
    },
    "sourceReferences": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "common.schema.json#/$defs/sourceReference" }
    },
    "expiresAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "supersedesThreadId": { "$ref": "common.schema.json#/$defs/id" }
  }
}
