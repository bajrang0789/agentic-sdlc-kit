{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bajrang0789/agentic-sdlc-kit/main/schemas/v1/control-point.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "id",
    "version",
    "status",
    "requiredSourceTypes",
    "requiredIssuers",
    "revision",
    "decidedAt"
  ],
  "properties": {
    "apiVersion": { "const": "agentic-sdlc-kit/v1" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "status": { "enum": ["pending", "satisfied", "failed", "waived", "stale"] },
    "requiredSourceTypes": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "maxLength": 128 },
      "uniqueItems": true
    },
    "requiredIssuers": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "common.schema.json#/$defs/id" },
      "uniqueItems": true
    },
    "revision": { "$ref": "common.schema.json#/$defs/revision" },
    "freshnessRequired": { "type": "boolean" },
    "satisfiedBy": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "common.schema.json#/$defs/id" },
      "uniqueItems": true
    },
    "failedBy": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "common.schema.json#/$defs/id" },
      "uniqueItems": true
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRecordId", "reason", "scope", "expiresAt", "revision"],
      "properties": {
        "sourceRecordId": { "$ref": "common.schema.json#/$defs/id" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "scope": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "expiresAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "revision": { "$ref": "common.schema.json#/$defs/revision" }
      }
    },
    "decidedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "satisfied" } }, "required": ["status"] },
      "then": {
        "required": ["satisfiedBy"],
        "properties": { "satisfiedBy": { "type": "array", "minItems": 1 } }
      }
    },
    {
      "if": { "properties": { "status": { "const": "waived" } }, "required": ["status"] },
      "then": { "required": ["waiver"] }
    }
  ]
}
