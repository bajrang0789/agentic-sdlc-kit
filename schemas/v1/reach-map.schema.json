{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bajrang0789/agentic-sdlc-kit/main/schemas/v1/reach-map.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "threadId", "repository", "revision", "entries", "unknowns"],
  "properties": {
    "apiVersion": { "const": "agentic-sdlc-kit/v1" },
    "threadId": { "$ref": "common.schema.json#/$defs/id" },
    "repository": { "$ref": "common.schema.json#/$defs/id" },
    "revision": { "$ref": "common.schema.json#/$defs/revision" },
    "entries": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "relation", "derivation", "sourceReferences", "confidence"],
        "properties": {
          "service": { "$ref": "common.schema.json#/$defs/id" },
          "relation": {
            "enum": [
              "direct",
              "shared-code",
              "runtime-upstream",
              "runtime-downstream",
              "data",
              "security",
              "unknown"
            ]
          },
          "derivation": { "enum": ["observed", "inferred"] },
          "sourceReferences": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": { "$ref": "common.schema.json#/$defs/sourceReference" }
          },
          "confidence": { "enum": ["low", "medium", "high"] },
          "criticality": { "enum": ["low", "medium", "high", "critical"] },
          "securityRelevant": { "type": "boolean" },
          "dataRelevant": { "type": "boolean" },
          "owner": { "$ref": "common.schema.json#/$defs/uri" },
          "runbook": { "$ref": "common.schema.json#/$defs/uri" }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "maxLength": 2048 }
    }
  }
}
