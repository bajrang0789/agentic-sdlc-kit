{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bajrang0789/agentic-sdlc-kit/main/schemas/v1/handoff-bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "threadId",
    "groundPacketDigest",
    "trackState",
    "completedWork",
    "changedPaths",
    "decisions",
    "claims",
    "sourceReferences",
    "outstandingControlPoints",
    "knownUnknowns",
    "nextSkills",
    "revision"
  ],
  "properties": {
    "apiVersion": { "const": "agentic-sdlc-kit/v1" },
    "threadId": { "$ref": "common.schema.json#/$defs/id" },
    "groundPacketDigest": { "$ref": "common.schema.json#/$defs/digest" },
    "trackState": { "$ref": "common.schema.json#/$defs/trackState" },
    "completedWork": {
      "type": "array",
      "maxItems": 256,
      "items": { "type": "string", "maxLength": 4096 }
    },
    "changedPaths": {
      "type": "array",
      "maxItems": 2048,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[^\\u0000]+$",
        "maxLength": 1024
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "common.schema.json#/$defs/id" }
    },
    "claims": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "common.schema.json#/$defs/id" }
    },
    "sourceReferences": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "common.schema.json#/$defs/sourceReference" }
    },
    "outstandingControlPoints": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "common.schema.json#/$defs/id" }
    },
    "knownUnknowns": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "maxLength": 2048 }
    },
    "nextSkills": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "common.schema.json#/$defs/id" }
    },
    "revision": { "$ref": "common.schema.json#/$defs/revision" }
  }
}
