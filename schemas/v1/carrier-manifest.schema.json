{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bajrang0789/agentic-sdlc-kit/main/schemas/v1/carrier-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "provider",
    "version",
    "canonicalSkills",
    "canonicalTreeDigest",
    "payloadTreeDigest",
    "files",
    "capabilityReductions"
  ],
  "properties": {
    "apiVersion": { "const": "agentic-sdlc-kit/v1" },
    "provider": { "enum": ["claude", "codex", "copilot", "devin"] },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "canonicalSkills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/canonicalSkill" }
    },
    "canonicalTreeDigest": { "$ref": "common.schema.json#/$defs/digest" },
    "payloadTreeDigest": { "$ref": "common.schema.json#/$defs/digest" },
    "files": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[^\\u0000]+$",
            "maxLength": 1024
          },
          "digest": { "$ref": "common.schema.json#/$defs/digest" }
        }
      }
    },
    "capabilityReductions": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "maxLength": 1024 }
    },
    "sourceDateEpoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  },
  "$defs": {
    "ids": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
      "uniqueItems": true
    },
    "io": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts", "states"],
      "properties": {
        "artifacts": { "$ref": "#/$defs/ids" },
        "states": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "common.schema.json#/$defs/trackState" },
          "uniqueItems": true
        }
      }
    },
    "controlPoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enter", "exit"],
      "properties": { "enter": { "$ref": "#/$defs/ids" }, "exit": { "$ref": "#/$defs/ids" } }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filesystem", "shell", "network", "secrets", "externalMutation"],
      "properties": {
        "filesystem": { "enum": ["deny", "read", "write"] },
        "shell": { "enum": ["deny", "allowlisted"] },
        "network": { "enum": ["deny", "allowlisted"] },
        "secrets": { "enum": ["deny", "read"] },
        "externalMutation": { "enum": ["deny", "gated", "delegated"] }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindToRevision"],
      "properties": { "bindToRevision": { "type": "boolean" } }
    },
    "canonicalSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest",
        "actionBand",
        "controlPoints",
        "requires",
        "produces",
        "freshness",
        "permissions",
        "reductions"
      ],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "version": { "type": "string", "maxLength": 64 },
        "digest": { "$ref": "common.schema.json#/$defs/digest" },
        "actionBand": { "$ref": "common.schema.json#/$defs/actionBand" },
        "controlPoints": { "$ref": "#/$defs/controlPoints" },
        "requires": { "$ref": "#/$defs/io" },
        "produces": { "$ref": "#/$defs/io" },
        "freshness": { "$ref": "#/$defs/freshness" },
        "permissions": { "$ref": "#/$defs/permissions" },
        "reductions": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "uniqueItems": true
        }
      }
    }
  }
}
